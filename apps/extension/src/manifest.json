{
  "manifest_version": 3,
  "name": "Хаттама Live Companion",
  "version": "0.1.0",
  "description": "Захват звука активной вкладки Google Meet / Teams Web / Zoom Web для локального протоколирования Хаттама Live.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Хаттама Live" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "setup.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
