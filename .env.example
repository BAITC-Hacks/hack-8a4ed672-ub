# Хаттама Live — пример конфигурации (секретов здесь нет). Скопируйте в .env и поправьте.
# Профиль ресурсов: gpu-6gb | gpu-large | cpu | cpu-8gb | test  (python tasks.py doctor подскажет)
HATTAMA_PROFILE=gpu-6gb

# Данные и модели храните ВНЕ OneDrive/Dropbox (иначе записи уйдут в облако).
# По умолчанию: Windows %LOCALAPPDATA%\Hattama\{data,models,tools}
# HATTAMA_DATA_DIR=C:/HattamaData/data
# HATTAMA_MODELS_DIR=C:/HattamaData/models
# HATTAMA_DATABASE_URL=postgresql+psycopg://hattama:***@db:5432/hattama   (по умолчанию SQLite в DATA_DIR)

# Веб-интерфейс отдаётся самим API: http://localhost:8000
HATTAMA_ALLOWED_ORIGINS=["http://localhost:8000"]
# ID расширения стабилен (ключ в apps/extension/src/manifest.json)
HATTAMA_ALLOWED_EXTENSION_IDS=["bibicplbpcephoocaemgdjjbbhfhfion"]
HATTAMA_COOKIE_SECURE=false

# Только ВНУТРЕННИЙ адрес локального llama.cpp; облачные API запрещены списком разрешённых хостов.
HATTAMA_LLM_BASE_URL=http://127.0.0.1:8081
HATTAMA_LLM_ALLOWED_HOSTS=["127.0.0.1","localhost"]
HATTAMA_DEFAULT_TIMEZONE=Asia/Almaty
